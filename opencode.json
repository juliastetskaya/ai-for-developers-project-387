{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "opencode/deepseek-v4.1-flash",
  "mcp": {
    "servers": {
      "hexlet": {
        "type": "remote",
        "url": "https://mcp.hexlet.io"
      },
      "render": {
        "type": "remote",
        "url": "https://mcp.render.com/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:RENDER_API_KEY}"
        }
      }
    }
  }
}
